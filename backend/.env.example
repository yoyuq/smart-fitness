# Smart Fitness backend environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ---- Vision providers (in priority order — set at least one) ----
# Alibaba DashScope (qwen-vl-max, qwen3-vl-plus, qwen-vl-plus) — recommended primary
DASHSCOPE_API_KEY=

# Volcengine Ark (doubao-seed-1-6-vision) — recommended fallback
VOLC_ARK_API_KEY=

# Optional additional providers
ZHIPU_API_KEY=
MOONSHOT_API_KEY=
HUNYUAN_API_KEY=

# ---- Vision behavior tuning (all optional) ----
# AI_AGENT_VISION_PROVIDERS=qwen,qwen-fast,qwen-cheap,volcengine   # override order
# AI_AGENT_VISION_MODEL=qwen-vl-max                                 # pin a specific model
# AI_AGENT_VISION_TIMEOUT=90                                        # seconds per call
# AI_AGENT_VISION_ENABLED=true
# AI_AGENT_VISION_FRAME_ROOTS=

# ---- Text LLM (Stage 2 of two-stage pipeline) ----
# AI_AGENT_LLM_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
# AI_AGENT_LLM_MODEL=doubao-1-5-pro-32k-250115
# AI_AGENT_LLM_API_KEY=      # falls back to VOLC_ARK_API_KEY if unset

# ---- Web search ----
# AI_AGENT_WEB_SEARCH_ACADEMIC_TIMEOUT=30
